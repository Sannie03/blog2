{
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/story/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|facebot|Twitterbot|twitterbot|LinkedInBot|linkedinbot|Slackbot|slackbot|Discordbot|discordbot|WhatsApp|whatsapp|TelegramBot|telegrambot|Zalo|zalo|Pinterest|pinterest|SkypeUriPreview|skypeuripreview|Googlebot|googlebot|bingbot).*" }],
      "destination": "https://blog2-2o8q.onrender.com/story/:slug"
    },
    {
      "source": "/post/:slug",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|Facebot|facebot|Twitterbot|twitterbot|LinkedInBot|linkedinbot|Slackbot|slackbot|Discordbot|discordbot|WhatsApp|whatsapp|TelegramBot|telegrambot|Zalo|zalo|Pinterest|pinterest|SkypeUriPreview|skypeuripreview|Googlebot|googlebot|bingbot).*" }],
      "destination": "https://blog2-2o8q.onrender.com/story/:slug"
    },
    {
      "source": "/ads.txt",
      "destination": "/ads.txt"
    },
    {
      "source": "/story/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/post/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
